# DG-Tags frontend environment (Vite).
#
# Vite only exposes VITE_-prefixed vars to client code and inlines them at
# BUILD time. Set before `npm run build` for production. Local dev can omit it
# (defaults to http://localhost:5000; the dev server also proxies /api there).

VITE_API_URL=https://api.dg-rater.com
