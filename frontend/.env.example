# DG-Dubs frontend environment (Vite).
#
# Vite only exposes variables prefixed with VITE_ to client code, and inlines
# them at BUILD time. Set this before `npm run build` for production deploys.
#
# Local dev can omit this (defaults to http://localhost:5000). The dev server
# also proxies /api -> http://localhost:5000 (see vite.config.ts).

VITE_API_URL=https://api.dg-rater.com
