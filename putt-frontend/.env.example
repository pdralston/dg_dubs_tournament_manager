# DG-Putt frontend environment (Vite).
#
# Vite only exposes VITE_-prefixed vars to client code and inlines them at
# BUILD time. This is also the Socket.IO connection origin. Local dev can omit
# it (defaults to http://localhost:5000; the dev server proxies /api and
# /socket.io there).

VITE_API_URL=https://api.dg-rater.com
