# DG-Rater unified SPA environment (Vite).
#
# Vite only exposes VITE_-prefixed vars to client code and inlines them at
# BUILD time. VITE_API_URL is the backend origin for both the HTTP API (/api/*)
# and the Socket.IO transport. Local dev can omit it (defaults to
# http://localhost:5000; the dev server proxies /api and /socket.io there).

VITE_API_URL=https://api.dg-rater.com
